# Copia este archivo como .env para desarrollo local. En Vercel, configura las
# mismas variables en Project Settings → Environment Variables.

# --- Frontend (públicas: se incluyen en el JavaScript del navegador) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Backend (secretas: nunca con prefijo VITE_) ---
# Puerto local del servidor; debe coincidir con el proxy de vite.config.ts.
PORT=3001

# Firma las sesiones. Obligatoria: sin ella el inicio de sesión queda deshabilitado.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Si antes de este cambio el servidor usaba otro SESSION_SECRET (o ninguno),
# las contraseñas antiguas se validan también con esta sal y se migran al iniciar sesión.
LEGACY_PASSWORD_SALT=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase → Project Settings → JWT Keys → Legacy JWT secret. Permite que RLS identifique al usuario.
SUPABASE_JWT_SECRET=

# Tasa de respaldo si ninguna API del BCV responde (el dashboard la marca como "estimada").
BCV_FALLBACK_RATE=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
